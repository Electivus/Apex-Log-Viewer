FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc

ARG ALV_E2E_PROXY_LAB_APT_TIMEOUT_SECONDS=20
ARG ALV_E2E_PROXY_LAB_APT_RETRIES=3

ENV DEBIAN_FRONTEND=noninteractive

RUN { \
    echo "Acquire::Retries \"${ALV_E2E_PROXY_LAB_APT_RETRIES}\";"; \
    echo "Acquire::http::Timeout \"${ALV_E2E_PROXY_LAB_APT_TIMEOUT_SECONDS}\";"; \
    echo "Acquire::https::Timeout \"${ALV_E2E_PROXY_LAB_APT_TIMEOUT_SECONDS}\";"; \
  } > /etc/apt/apt.conf.d/99alv-proxy-lab-timeouts \
  && apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    mitmproxy \
    netcat-openbsd \
  && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /mitmproxy && chmod 0777 /mitmproxy

EXPOSE 8888

COPY proxy.sh /usr/local/bin/alv-proxy
CMD ["sh", "/usr/local/bin/alv-proxy"]
