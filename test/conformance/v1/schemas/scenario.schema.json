{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://electivus.dev/apex-log-viewer/conformance/v1/scenario.schema.json",
  "title": "Apex Log Viewer dual-runtime conformance scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "description", "operation", "request", "workspace", "doubles", "expected"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "description": { "type": "string", "minLength": 1 },
    "operation": { "enum": ["log.status", "log.list"] },
    "request": {
      "oneOf": [{ "$ref": "#/$defs/statusRequest" }, { "$ref": "#/$defs/logListRequest" }]
    },
    "workspace": { "$ref": "#/$defs/workspace" },
    "doubles": { "$ref": "#/$defs/doubles" },
    "expected": {
      "oneOf": [
        { "$ref": "#/$defs/statusSuccess" },
        { "$ref": "#/$defs/logListSuccess" },
        { "$ref": "#/$defs/failureOutcome" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "log.status" } }, "required": ["operation"] },
      "then": {
        "properties": {
          "request": { "$ref": "#/$defs/statusRequest" },
          "expected": {
            "oneOf": [{ "$ref": "#/$defs/statusSuccess" }, { "$ref": "#/$defs/failureOutcome" }]
          }
        }
      }
    },
    {
      "if": { "properties": { "operation": { "const": "log.list" } }, "required": ["operation"] },
      "then": {
        "properties": {
          "request": { "$ref": "#/$defs/logListRequest" },
          "expected": {
            "oneOf": [{ "$ref": "#/$defs/logListSuccess" }, { "$ref": "#/$defs/failureOutcome" }]
          }
        }
      }
    }
  ],
  "$defs": {
    "statusRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceRoot"],
      "properties": {
        "workspaceRoot": { "type": "string", "minLength": 1 },
        "targetOrg": { "type": "string", "minLength": 1 }
      }
    },
    "logListRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceRoot", "username"],
      "properties": {
        "workspaceRoot": { "type": "string", "minLength": 1 },
        "username": { "type": "string", "minLength": 1 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
      }
    },
    "statusSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result"],
      "properties": {
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targetOrg",
            "safeTargetOrg",
            "workspaceRoot",
            "apexlogsRoot",
            "stateFile",
            "logCount",
            "hasState",
            "downloadedCount",
            "cachedCount"
          ],
          "properties": {
            "targetOrg": { "type": "string", "minLength": 1 },
            "safeTargetOrg": { "type": "string", "minLength": 1 },
            "workspaceRoot": { "type": "string", "minLength": 1 },
            "apexlogsRoot": { "type": "string", "minLength": 1 },
            "stateFile": { "type": "string", "minLength": 1 },
            "logCount": { "type": "integer", "minimum": 0 },
            "hasState": { "type": "boolean" },
            "lastSyncStartedAt": { "type": "string", "minLength": 1 },
            "lastSyncCompletedAt": { "type": "string", "minLength": 1 },
            "lastSyncedLogId": { "type": "string", "minLength": 1 },
            "lastSyncedStartTime": { "type": "string", "minLength": 1 },
            "downloadedCount": { "type": "integer", "minimum": 0 },
            "cachedCount": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "logListSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result"],
      "properties": {
        "result": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "startTime": { "type": "string", "minLength": 1 },
              "operation": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 },
              "logLength": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "failureOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure"],
      "properties": {
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "workspaceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
        },
        "content": { "type": "string" }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": { "type": "array", "items": { "$ref": "#/$defs/workspaceFile" } },
        "after": { "type": "array", "items": { "$ref": "#/$defs/workspaceFile" } }
      }
    },
    "processInteraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "request"],
      "oneOf": [
        { "required": ["response"], "properties": { "response": true } },
        { "required": ["responses"], "properties": { "responses": true } }
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executable", "arguments"],
          "properties": {
            "executable": { "type": "string", "minLength": 1 },
            "arguments": { "type": "array", "items": { "type": "string" } },
            "cwd": { "type": "string", "minLength": 1 }
          }
        },
        "response": { "$ref": "#/$defs/processResponse" },
        "responses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/processResponse" }
        }
      }
    },
    "processResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exitCode", "stdout", "stderr"],
      "properties": {
        "exitCode": { "type": "integer" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" }
      }
    },
    "httpInteraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "request"],
      "oneOf": [
        { "required": ["response"], "properties": { "response": true } },
        { "required": ["responses"], "properties": { "responses": true } }
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "url"],
          "properties": {
            "method": { "type": "string", "pattern": "^[A-Z]+$" },
            "url": { "type": "string", "minLength": 1 },
            "headers": { "type": "object", "additionalProperties": { "type": "string" } },
            "body": true
          }
        },
        "response": { "$ref": "#/$defs/httpResponse" },
        "responses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/httpResponse" }
        }
      }
    },
    "httpResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "headers", "body"],
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "body": true
      }
    },
    "doubles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process", "http"],
      "properties": {
        "process": { "type": "array", "items": { "$ref": "#/$defs/processInteraction" } },
        "http": { "type": "array", "items": { "$ref": "#/$defs/httpInteraction" } }
      }
    }
  }
}
