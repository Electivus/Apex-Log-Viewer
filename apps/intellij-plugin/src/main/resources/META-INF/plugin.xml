<idea-plugin>
    <id>com.electivus.apexlogviewer</id>
    <name>Electivus Apex Log Viewer</name>
    <vendor url="https://github.com/Electivus/Apex-Log-Viewer">Electivus</vendor>
    <change-notes><![CDATA[
        Initial native IntelliJ development build with Logs, Unified Log Search,
        Parsed Log Viewer, raw-log opening, and optional Illuminated Cloud 2 replay handoff.
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.idea</depends>
    <resource-bundle>messages.ApexLogViewerBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <fileEditorProvider implementation="com.electivus.apexlogviewer.ui.ParsedLogFileEditorProvider" />
        <applicationConfigurable
            id="com.electivus.apexlogviewer.settings"
            displayName="%settings.displayName"
            instance="com.electivus.apexlogviewer.ui.ApexLogViewerConfigurable" />
        <toolWindow
            id="Electivus Apex Log Viewer"
            anchor="bottom"
            icon="AllIcons.FileTypes.Text"
            factoryClass="com.electivus.apexlogviewer.ui.ApexLogViewerToolWindowFactory" />
    </extensions>

    <actions>
        <action
            id="ApexLogViewer.RefreshLogs"
            class="com.electivus.apexlogviewer.ui.RefreshLogsAction"
            icon="AllIcons.Actions.Refresh" />
        <action
            id="ApexLogViewer.LoadMoreLogs"
            class="com.electivus.apexlogviewer.ui.LoadMoreLogsAction"
            icon="AllIcons.Actions.MoveDown" />
        <action id="ApexLogViewer.CancelSearch" class="com.electivus.apexlogviewer.ui.CancelLogSearchAction"
            icon="AllIcons.Actions.Cancel" />
        <action id="ApexLogViewer.ContinueSearch" class="com.electivus.apexlogviewer.ui.ContinueLogSearchAction"
            icon="AllIcons.Actions.Execute" />
        <action id="ApexLogViewer.RetrySearch" class="com.electivus.apexlogviewer.ui.RetryLogSearchAction"
            icon="AllIcons.Actions.Rerun" />
        <action id="ApexLogViewer.DownloadAllLogs" class="com.electivus.apexlogviewer.ui.DownloadAllLogsAction"
            icon="AllIcons.Actions.Download" />
        <action id="ApexLogViewer.CancelDownloadAll" class="com.electivus.apexlogviewer.ui.CancelDownloadAllLogsAction"
            icon="AllIcons.Actions.Suspend" />
        <action
            id="ApexLogViewer.OpenParsedLog"
            class="com.electivus.apexlogviewer.ui.OpenParsedLogAction"
            icon="AllIcons.Actions.Preview">
            <add-to-group group-id="EditorPopupMenu" anchor="last" />
        </action>
        <action
            id="ApexLogViewer.OpenRawLog"
            class="com.electivus.apexlogviewer.ui.OpenRawLogAction"
            icon="AllIcons.Actions.ShowCode" />
        <action
            id="ApexLogViewer.OpenInIlluminatedCloud"
            class="com.electivus.apexlogviewer.ui.OpenInIlluminatedCloudAction"
            icon="AllIcons.Actions.StartDebugger" />
        <action id="ApexLogViewer.OpenDiagnostics" class="com.electivus.apexlogviewer.ui.OpenDiagnosticsAction"
            icon="AllIcons.Actions.Show">
            <add-to-group group-id="HelpMenu" anchor="last" />
        </action>
    </actions>
</idea-plugin>
